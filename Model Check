    "import glob\n",
    "import matplotlib.pyplot as plt\n",
    "import os\n",
    "import cv2\n",
    "from ultralytics import YOLO\n",
    "\n",
    "# Sesuai dengan parameter 'name' di training loop cell 7\n",
    "model_folders = ['yolov8n-seg.pt', 'yolo11n-seg.pt', 'yolo26n-seg.pt']\n",
    "base_run_path = \"/kaggle/working/green_ai_tournament\"\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(20, 10))\n",
    "plt.subplots_adjust(wspace=0.1)\n",
    "\n",
    "# Ambil sample test path\n",
    "test_images_path = \"/kaggle/working/cropped_dataset_v3/valid/images\"\n",
    "\n",
    "for i, folder in enumerate(model_folders):\n",
    "    best_model_path = os.path.join(base_run_path, folder, \"weights/best.pt\")\n",
    "    \n",
    "    if os.path.exists(best_model_path):\n",
    "        print(f\"🧐 Testing Model: {folder}...\")\n",
    "        model = YOLO(best_model_path)\n",
    "        \n",
    "        results = model.predict(\n",
    "            source=test_images_path, \n",
    "            save=True, \n",
    "            conf=0.25, \n",
    "            project=\"/kaggle/working/comparison\",\n",
    "            name=f\"pred_{folder}\",\n",
    "            exist_ok=True \n",
    "        )\n",
    "        \n",
    "        predict_files = glob.glob(f\"/kaggle/working/comparison/pred_{folder}/*.jpg\")\n",
    "        \n",
    "        if predict_files:\n",
    "            img_res = cv2.imread(predict_files[0])\n",
    "            axes[i].imshow(cv2.cvtColor(img_res, cv2.COLOR_BGR2RGB))\n",
    "            axes[i].set_title(f\"Model: {folder.upper()}\\n(Green AI)\", fontsize=12)\n",
    "            axes[i].axis('off')\n",
    "    else:\n",
    "        axes[i].text(0.5, 0.5, f\"❌ {folder}\\nNot Found\", ha='center', va='center', color='red')\n",
    "        axes[i].axis('off')\n",
    "\n",
    "plt.suptitle(\"Head-to-Head Comparison: Isolated Object Segmentation\", fontsize=16)\n",
    "plt.show()"
   ]
