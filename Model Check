    "# --- STEP 3: MODEL TOURNAMENT & AUTO-TUNING ---\n",
    "\n",
    "import yaml\n",
    "\n",
    "with open(data_yaml_path, 'r') as f:\n",
    "    data_config = yaml.safe_load(f)\n",
    "    my_classes = data_config['names']\n",
    "\n",
    "print(f\"✅ Kelas yang terdeteksi di Dataset: {my_classes}\")\n",
    "print(f\"🚀 Model akan dilatih HANYA untuk {len(my_classes)} kelas ini.\")\n",
    "\n",
    "# Daftar model yang akan diadu (Nano version agar cepat di Colab)\n",
    "models_to_compare = ['yolov8n-seg.pt', 'yolo11n-seg.pt', 'yolo26n-seg.pt']\n",
    "summary_results = []\n",
    "\n",
    "for model_name in models_to_compare:\n",
    "    print(f\"\\n{'='*50}\")\n",
    "    print(f\"STARTING EVALUATION FOR: {model_name}\")\n",
    "    print(f\"{'='*50}\")\n",
    "\n",
    "    # Load Model\n",
    "    model = YOLO(model_name)\n",
    "\n",
    "    # Run Hyperparameter Tuning (Logika Regression Otomatis)\n",
    "    # Iterations=10 berarti dia akan mencoba 10 kombinasi parameter berbeda\n",
    "    # Epochs=30 cukup untuk 10 gambar sebagai benchmark awal\n",
    "    tuning_results = model.tune(\n",
    "        data=data_yaml_path,\n",
    "        epochs=30,\n",
    "        iterations=10,\n",
    "        optimizer='AdamW',\n",
    "        plots=True,\n",
    "        save=True,\n",
    "        val=True\n",
    "    )\n",
    "\n",
    "    # Mengambil metrik terbaik setelah tuning\n",
    "    metrics = model.val(data=data_yaml_path)\n",
    "    summary_results.append({\n",
    "        \"Model\": model_name,\n",
    "        \"mAP50-95(M)\": metrics.seg.map,    # Mean Average Precision untuk Mask\n",
    "        \"Precision(M)\": metrics.seg.mp,   # Presisi\n",
    "        \"Recall(M)\": metrics.seg.mr,      # Recall\n",
    "        \"Fitness\": metrics.fitness        # Skor keseluruhan\n",
    "    })\n",
    "\n",
    "# --- STEP 4: DISPLAY SUMMARY TABLE ---\n",
    "df = pd.DataFrame(summary_results)\n",
    "print(\"\\n\\n📊 HASIL PERBANDINGAN MODEL:\")\n",
    "print(df.sort_values(by=\"Fitness\", ascending=False))\n",
    "\n",
    "# Simpan hasil ke CSV untuk bahan presentasi\n",
    "df.to_csv(\"model_comparison_results.csv\", index=False)"
   ]
