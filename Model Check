    "import os\n",
    "import cv2\n",
    "import yaml\n",
    "import shutil\n",
    "import numpy as np\n",
    "from tqdm.notebook import tqdm\n",
    "from sahi.slicing import slice_image\n",
    "from PIL import Image # <-- Tambahan PENTING untuk menyimpan Numpy Array\n",
    "\n",
    "# --- KONFIGURASI SLICING ---\n",
    "INPUT_DIR = \"/kaggle/working/final_dataset\"  # Dataset gabungan (38 gambar)\n",
    "OUTPUT_DIR = \"/kaggle/working/sliced_dataset_v2\" # Output ribuan tiles\n",
    "SLICE_SIZE = 640     # Ukuran standar YOLO Medium\n",
    "OVERLAP = 0.2        # 20% tumpang tindih\n",
    "\n",
    "# Bersihkan output lama agar bersih\n",
    "if os.path.exists(OUTPUT_DIR):\n",
    "    shutil.rmtree(OUTPUT_DIR)\n",
    "\n",
    "# Buat struktur folder baru\n",
    "for split in ['train', 'valid']:\n",
    "    os.makedirs(f\"{OUTPUT_DIR}/{split}/images\", exist_ok=True)\n",
    "    os.makedirs(f\"{OUTPUT_DIR}/{split}/labels\", exist_ok=True)\n",
    "\n",
    "def process_slicing(split_name):\n",
    "    image_dir = f\"{INPUT_DIR}/{split_name}/images\"\n",
    "    label_dir = f\"{INPUT_DIR}/{split_name}/labels\"\n",
    "    \n",
    "    if not os.path.exists(image_dir):\n",
    "        print(f\"⚠️ Folder {image_dir} tidak ditemukan. Skipping...\")\n",
    "        return\n",
    "\n",
    "    image_files = [f for f in os.listdir(image_dir) if f.endswith(('.jpg', '.jpeg', '.png'))]\n",
    "    \n",
    "    print(f\"🔪 Slicing {split_name} data ({len(image_files)} images)...\")\n",
    "    \n",
    "    for img_file in tqdm(image_files):\n",
    "        # Path file\n",
    "        img_path = os.path.join(image_dir, img_file)\n",
    "        img_stem = img_file.rsplit('.', 1)[0]\n",
    "        txt_path = os.path.join(label_dir, img_stem + '.txt')\n",
    "        \n",
    "        has_label = os.path.exists(txt_path)\n",
    "        \n",
    "        # --- SAHI SLICING ---\n",
    "        slice_image_result = slice_image(\n",
    "            image=img_path,\n",
    "            slice_height=SLICE_SIZE,\n",
    "            slice_width=SLICE_SIZE,\n",
    "            overlap_height_ratio=OVERLAP,\n",
    "            overlap_width_ratio=OVERLAP,\n",
    "            verbose=False\n",
    "        )\n",
    "        \n",
    "        # Baca Label Asli untuk referensi ukuran\n",
    "        img_h, img_w, _ = cv2.imread(img_path).shape\n",
    "        original_labels = []\n",
    "        if has_label:\n",
    "            with open(txt_path, 'r') as f:\n",
    "                for line in f:\n",
    "                    parts = line.strip().split()\n",
    "                    if len(parts) > 1:\n",
    "                        cls = int(parts[0])\n",
    "                        coords = [float(x) for x in parts[1:]]\n",
    "                        original_labels.append((cls, coords))\n",
    "\n",
    "        # Simpan Setiap Potongan (Tiles)\n",
    "        for i, sliced_image in enumerate(slice_image_result.sliced_image_list):\n",
    "            \n",
    "            # Buat nama file unik\n",
    "            save_name = f\"{img_stem}_slice_{i}.jpg\"\n",
    "            save_img_path = f\"{OUTPUT_DIR}/{split_name}/images/{save_name}\"\n",
    "            save_lbl_path = f\"{OUTPUT_DIR}/{split_name}/labels/{save_name.replace('.jpg', '.txt')}\"\n",
    "            \n",
    "            # --- PERBAIKAN DI SINI ---\n",
    "            # Konversi Numpy Array ke PIL Image dulu, baru save\n",
    "            img_pil = Image.fromarray(sliced_image.image)\n",
    "            img_pil.save(save_img_path)\n",
    "            \n",
    "            # Hitung Ulang Koordinat Label\n",
    "            starting_pixel = sliced_image.starting_pixel # [x, y]\n",
    "            \n",
    "            new_labels = []\n",
    "            if original_labels:\n",
    "                x_off, y_off = starting_pixel\n",
    "                \n",
    "                for cls, coords in original_labels:\n",
    "                    # Normalized -> Pixel\n",
    "                    poly_coords = np.array(coords).reshape(-1, 2)\n",
    "                    poly_coords[:, 0] *= img_w\n",
    "                    poly_coords[:, 1] *= img_h\n",
    "                    \n",
    "                    # Shift ke koordinat slice\n",
    "                    poly_coords[:, 0] -= x_off\n",
    "                    poly_coords[:, 1] -= y_off\n",
    "                    \n",
    "                    # Filter poligon di luar slice\n",
    "                    if np.all((poly_coords < 0) | (poly_coords > SLICE_SIZE)):\n",
    "                        continue\n",
    "                        \n",
    "                    # Clip agar tidak keluar batas gambar\n",
    "                    poly_coords = np.clip(poly_coords, 0, SLICE_SIZE)\n",
    "                    \n",
    "                    # Validasi minimal 3 titik\n",
    "                    if len(poly_coords) < 3: continue\n",
    "                    \n",
    "                    # Pixel -> Normalized (0-1) relative to Slice Size\n",
    "                    poly_coords[:, 0] /= SLICE_SIZE\n",
    "                    poly_coords[:, 1] /= SLICE_SIZE\n",
    "                    \n",
    "                    flat_coords = poly_coords.flatten()\n",
    "                    str_coords = \" \".join([f\"{x:.6f}\" for x in flat_coords])\n",
    "                    new_labels.append(f\"{cls} {str_coords}\")\n",
    "            \n",
    "            # Simpan Label Baru\n",
    "            if new_labels:\n",
    "                with open(save_lbl_path, 'w') as f:\n",
    "                    f.write(\"\\n\".join(new_labels))\n",
    "\n",
    "# Eksekusi\n",
    "process_slicing('train')\n",
    "process_slicing('valid')\n",
    "\n",
    "# SETUP YAML BARU\n",
    "names = {0: 'Relief'} \n",
    "try:\n",
    "    with open(\"/kaggle/working/final_dataset/data.yaml\") as f:\n",
    "        d = yaml.safe_load(f)\n",
    "        names = d['names']\n",
    "except:\n",
    "    pass\n",
    "\n",
    "new_yaml = {\n",
    "    'path': OUTPUT_DIR,\n",
    "    'train': 'train/images',\n",
    "    'val': 'valid/images',\n",
    "    'names': names,\n",
    "    'nc': len(names)\n",
    "}\n",
    "\n",
    "with open(\"/kaggle/working/sliced_data_v2.yaml\", 'w') as f:\n",
    "    yaml.dump(new_yaml, f)\n",
    "\n",
    "# CEK HASIL\n",
    "n_train = len(os.listdir(f\"{OUTPUT_DIR}/train/images\"))\n",
    "n_val = len(os.listdir(f\"{OUTPUT_DIR}/valid/images\"))\n",
    "print(f\"\\n✅ SLICING SELESAI!\")\n",
    "print(f\"📊 Total Training Tiles: {n_train}\")\n",
    "print(f\"📊 Total Validation Tiles: {n_val}\")\n",
    "print(f\"📄 Config baru siap: /kaggle/working/sliced_data_v2.yaml\")"
   ]
  },
