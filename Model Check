    "import os\n",
    "import cv2\n",
    "import numpy as np\n",
    "import glob\n",
    "from pathlib import Path\n",
    "\n",
    "def slice_yolo_dataset(img_dir, label_dir, output_img_dir, output_label_dir, slice_size=640, overlap=0.2):\n",
    "    os.makedirs(output_img_dir, exist_ok=True)\n",
    "    os.makedirs(output_label_dir, exist_ok=True)\n",
    "    \n",
    "    image_files = glob.glob(os.path.join(img_dir, \"*.jpg\"))\n",
    "    stride = int(slice_size * (1 - overlap))\n",
    "    \n",
    "    print(f\"Slicing {len(image_files)} images dari {img_dir}...\")\n",
    "\n",
    "    for img_path in image_files:\n",
    "        img_name = Path(img_path).stem\n",
    "        img = cv2.imread(img_path)\n",
    "        h, w, _ = img.shape\n",
    "        \n",
    "        # Baca label YOLO yang sesuai\n",
    "        label_path = os.path.join(label_dir, f\"{img_name}.txt\")\n",
    "        if not os.path.exists(label_path): continue\n",
    "        \n",
    "        with open(label_path, 'r') as f:\n",
    "            lines = f.readlines()\n",
    "\n",
    "        # Tiling process\n",
    "        for y in range(0, h - slice_size + 1, stride):\n",
    "            for x in range(0, w - slice_size + 1, stride):\n",
    "                # Potong gambar\n",
    "                tile = img[y:y+slice_size, x:x+slice_size]\n",
    "                tile_name = f\"{img_name}_y{y}_x{x}\"\n",
    "                \n",
    "                new_labels = []\n",
    "                for line in lines:\n",
    "                    parts = line.split()\n",
    "                    cls = parts[0]\n",
    "                    coords = np.array([float(p) for p in parts[1:]]).reshape(-1, 2)\n",
    "                    \n",
    "                    # Konversi koordinat normal (0-1) ke pixel asli\n",
    "                    coords_px = coords * [w, h]\n",
    "                    \n",
    "                    # Cek apakah poligon ada di dalam tile ini\n",
    "                    # (Sederhananya: apakah ada titik yang masuk dalam kotak tile)\n",
    "                    mask = (coords_px[:, 0] >= x) & (coords_px[:, 0] <= x + slice_size) & \\\n",
    "                           (coords_px[:, 1] >= y) & (coords_px[:, 1] <= y + slice_size)\n",
    "                    \n",
    "                    if np.any(mask):\n",
    "                        # Geser koordinat ke sistem koordinat tile (0-slice_size)\n",
    "                        new_coords = (coords_px - [x, y]) / slice_size\n",
    "                        # Clip agar tidak keluar batas 0-1\n",
    "                        new_coords = np.clip(new_coords, 0, 1)\n",
    "                        \n",
    "                        formatted_coords = \" \".join([f\"{p:.6f}\" for p in new_coords.flatten()])\n",
    "                        new_labels.append(f\"{cls} {formatted_coords}\")\n",
    "                \n",
    "                # Simpan tile hanya jika ada label di dalamnya\n",
    "                if new_labels:\n",
    "                    cv2.imwrite(os.path.join(output_img_dir, f\"{tile_name}.jpg\"), tile)\n",
    "                    with open(os.path.join(output_label_dir, f\"{tile_name}.txt\"), 'w') as f:\n",
    "                        f.write(\"\\n\".join(new_labels))\n",
    "\n",
    "# Eksekusi Slicing untuk Train dan Val\n",
    "# Pastikan path ini sesuai dengan output download Roboflow Anda\n",
    "base_path = dataset.location\n",
    "slice_yolo_dataset(f\"{base_path}/train/images\", f\"{base_path}/train/labels\", \"/kaggle/working/sliced/train/images\", \"/kaggle/working/sliced/train/labels\")\n",
    "slice_yolo_dataset(f\"{base_path}/valid/images\", f\"{base_path}/valid/labels\", \"/kaggle/working/sliced/valid/images\", \"/kaggle/working/sliced/valid/labels\")\n",
    "\n",
    "# Update data.yaml untuk menunjuk ke folder \"sliced\"\n",
    "new_yaml = {\n",
    "    'train': '/kaggle/working/sliced/train/images',\n",
    "    'val': '/kaggle/working/sliced/valid/images',\n",
    "    'nc': len(config['names']),\n",
    "    'names': config['names']\n",
    "}\n",
    "with open('/kaggle/working/sliced_data.yaml', 'w') as f:\n",
    "    yaml.dump(new_yaml, f)\n",
    "\n",
    "print(\"✅ Slicing selesai! Sekarang gunakan '/kaggle/working/sliced_data.yaml' untuk training.\")"
   ]
