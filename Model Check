   "source": [
    "import glob\n",
    "import matplotlib.pyplot as plt\n",
    "import os\n",
    "import cv2\n",
    "import torch\n",
    "import gc\n",
    "from ultralytics import YOLO\n",
    "\n",
    "# PASTIKAN NAMA FOLDER TANPA .PT (Sesuai parameter 'name' di Cell 7)\n",
    "model_folders = ['yolov8m-seg', 'yolo11m-seg', 'yolo26m-seg'] # Ubah jika Anda pakai yolo26\n",
    "base_run_path = \"/kaggle/working/green_ai_tournament\"\n",
    "\n",
    "# DUA TARGET PENGUJIAN\n",
    "test_cropped_path = \"/kaggle/working/cropped_dataset_v4/valid/images\"\n",
    "test_full_path = \"/kaggle/working/final_dataset/valid/images\"\n",
    "\n",
    "# Siapkan plot: 2 Baris (Cropped vs Full), Kolom = Jumlah Model\n",
    "fig, axes = plt.subplots(2, len(model_folders), figsize=(20, 12))\n",
    "plt.subplots_adjust(wspace=0.1, hspace=0.3)\n",
    "\n",
    "for col_idx, folder in enumerate(model_folders):\n",
    "    best_model_path = os.path.join(base_run_path, folder, \"weights/best.pt\")\n",
    "    \n",
    "    if os.path.exists(best_model_path):\n",
    "        print(f\"🧐 Testing Model: {folder}...\")\n",
    "        model = YOLO(best_model_path)\n",
    "\n",
    "        # --- BERSIHKAN VRAM SEBELUM GAMBAR KECIL ---\n",
    "        torch.cuda.empty_cache()\n",
    "        gc.collect()\n",
    "        \n",
    "        # --- TEST 1: PADA GAMBAR CROPPED (BARIS ATAS) ---\n",
    "        # Untuk gambar kecil, GPU masih sanggup, jadi kita biarkan default (GPU)\n",
    "        model.predict(\n",
    "            source=test_cropped_path, save=True, conf=0.25, imgsz=640,\n",
    "            project=\"/kaggle/working/comparison_crop\", name=folder, exist_ok=True \n",
    "        )\n",
    "        crop_files = glob.glob(f\"/kaggle/working/comparison_crop/{folder}/*.jpg\")\n",
    "        \n",
    "        if crop_files:\n",
    "            img_crop = cv2.imread(crop_files[0])\n",
    "            axes[0, col_idx].imshow(cv2.cvtColor(img_crop, cv2.COLOR_BGR2RGB))\n",
    "            axes[0, col_idx].set_title(f\"[{folder}]\\nTEST 1: Cropped Image\", fontsize=12, fontweight='bold')\n",
    "            axes[0, col_idx].axis('off')\n",
    "\n",
    "        # --- BERSIHKAN VRAM LAGI SEBELUM GAMBAR RAKSASA ---\n",
    "        torch.cuda.empty_cache()\n",
    "        gc.collect()\n",
    "            \n",
    "        # --- TEST 2: PADA GAMBAR FULL ASLI (BARIS BAWAH) ---\n",
    "        print(f\"   Memproses gambar besar {folder} menggunakan CPU agar tidak OOM...\")\n",
    "        model.predict(\n",
    "            source=test_full_path, save=True, conf=0.25, imgsz=1024, \n",
    "            project=\"/kaggle/working/comparison_full\", name=folder, exist_ok=True,\n",
    "            device='cpu' # <--- INI KUNCI PENYELESAIANNYA\n",
    "        )\n",
    "        full_files = glob.glob(f\"/kaggle/working/comparison_full/{folder}/*.jpg\")\n",
    "        \n",
    "        if full_files:\n",
    "            img_full = cv2.imread(full_files[0])\n",
    "            axes[1, col_idx].imshow(cv2.cvtColor(img_full, cv2.COLOR_BGR2RGB))\n",
    "            axes[1, col_idx].set_title(f\"[{folder}]\\nTEST 2: Full Context Image\", fontsize=12, fontweight='bold')\n",
    "            axes[1, col_idx].axis('off')\n",
    "\n",
    "    else:\n",
    "        # Menangani Error tanpa Emoji\n",
    "        axes[0, col_idx].text(0.5, 0.5, f\"[X] MODEL NOT FOUND:\\n{folder}\", ha='center', va='center', color='red', fontsize=14)\n",
    "        axes[0, col_idx].axis('off')\n",
    "        axes[1, col_idx].axis('off')\n",
    "\n",
    "plt.suptitle(\"Model Evaluation: Small Cropped Detail vs Full Relief Context\", fontsize=16, fontweight='bold')\n",
    "plt.show()"
   ]
  }
