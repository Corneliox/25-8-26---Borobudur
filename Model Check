    "import os\n",
    "import yaml\n",
    "import shutil\n",
    "import glob\n",
    "from roboflow import Roboflow\n",
    "from kaggle_secrets import UserSecretsClient\n",
    "\n",
    "# --- KONFIGURASI PATH ---\n",
    "FINAL_DATASET_DIR = \"/kaggle/working/final_dataset\"\n",
    "os.makedirs(f\"{FINAL_DATASET_DIR}/train/images\", exist_ok=True)\n",
    "os.makedirs(f\"{FINAL_DATASET_DIR}/train/labels\", exist_ok=True)\n",
    "os.makedirs(f\"{FINAL_DATASET_DIR}/valid/images\", exist_ok=True)\n",
    "os.makedirs(f\"{FINAL_DATASET_DIR}/valid/labels\", exist_ok=True)\n",
    "\n",
    "# --- FUNGSI PEMINDAH FILE ---\n",
    "def merge_folders(source_dir, dest_dir_img, dest_dir_lbl):\n",
    "    # Pindahkan Images\n",
    "    for img_path in glob.glob(f\"{source_dir}/train/images/*\"):\n",
    "        shutil.copy(img_path, dest_dir_img)\n",
    "    for img_path in glob.glob(f\"{source_dir}/valid/images/*\"): # Validasi juga kita gabung dulu\n",
    "        shutil.copy(img_path, dest_dir_img)\n",
    "        \n",
    "    # Pindahkan Labels\n",
    "    for lbl_path in glob.glob(f\"{source_dir}/train/labels/*\"):\n",
    "        shutil.copy(lbl_path, dest_dir_lbl)\n",
    "    for lbl_path in glob.glob(f\"{source_dir}/valid/labels/*\"):\n",
    "        shutil.copy(lbl_path, dest_dir_lbl)\n",
    "        \n",
    "    print(f\"✅ Merged content from: {source_dir}\")\n",
    "\n",
    "# --- 1. DOWNLOAD DATASET KELOMPOK 1 ---\n",
    "print(\"\\n⬇️ Downloading Dataset Group 1...\")\n",
    "user_secrets = UserSecretsClient()\n",
    "api_key_1 = user_secrets.get_secret(\"roboflow borobudur api\")\n",
    "rf1 = Roboflow(api_key=api_key_1)\n",
    "project1 = rf1.workspace(\"cornelio\").project(\"borobudur-kelompok-1\")\n",
    "dataset1 = project1.version(3).download(\"yolo26\") # Menggunakan format YOLOv8/v11/v26\n",
    "\n",
    "# --- 2. DOWNLOAD DATASET KELOMPOK 2 ---\n",
    "print(\"\\n⬇️ Downloading Dataset Group 2...\")\n",
    "api_key_2 = user_secrets.get_secret(\"roboflow borobudur api2\") # Menggunakan secret baru\n",
    "rf2 = Roboflow(api_key=api_key_2)\n",
    "project2 = rf2.workspace(\"arjun-ke4sd\").project(\"borobudur-kelompok-2\")\n",
    "dataset2 = project2.version(1).download(\"yolo26\")\n",
    "\n",
    "# --- 3. MERGE DATASETS ---\n",
    "print(\"\\n🔄 Merging Datasets into One...\")\n",
    "# Gabungkan Dataset 1\n",
    "merge_folders(dataset1.location, f\"{FINAL_DATASET_DIR}/train/images\", f\"{FINAL_DATASET_DIR}/train/labels\")\n",
    "# Gabungkan Dataset 2\n",
    "merge_folders(dataset2.location, f\"{FINAL_DATASET_DIR}/train/images\", f\"{FINAL_DATASET_DIR}/train/labels\")\n",
    "\n",
    "# --- 4. CREATE MANUAL SPLIT (Train/Val) ---\n",
    "# Karena kita menggabungkan semuanya ke folder train, kita perlu memisahkannya lagi secara manual\n",
    "# Agar proporsi validasi seimbang (misal 80% Train, 20% Validasi)\n",
    "import random\n",
    "\n",
    "all_images = glob.glob(f\"{FINAL_DATASET_DIR}/train/images/*\")\n",
    "random.shuffle(all_images)\n",
    "\n",
    "val_ratio = 0.2\n",
    "num_val = int(len(all_images) * val_ratio)\n",
    "val_images = all_images[:num_val]\n",
    "\n",
    "print(f\"\\n📦 Total Images: {len(all_images)}\")\n",
    "print(f\"📦 Moving {num_val} images to Validation set...\")\n",
    "\n",
    "for img_path in val_images:\n",
    "    # Pindahkan Gambar\n",
    "    file_name = os.path.basename(img_path)\n",
    "    shutil.move(img_path, f\"{FINAL_DATASET_DIR}/valid/images/{file_name}\")\n",
    "    \n",
    "    # Pindahkan Label (jika ada)\n",
    "    label_name = file_name.rsplit('.', 1)[0] + \".txt\"\n",
    "    src_label = f\"{FINAL_DATASET_DIR}/train/labels/{label_name}\"\n",
    "    if os.path.exists(src_label):\n",
    "        shutil.move(src_label, f\"{FINAL_DATASET_DIR}/valid/labels/{label_name}\")\n",
    "\n",
    "# --- 5. SETUP DATA.YAML BARU ---\n",
    "# Ambil nama kelas dari salah satu dataset (asumsi nama kelas sama)\n",
    "with open(f\"{dataset1.location}/data.yaml\", 'r') as f:\n",
    "    base_config = yaml.safe_load(f)\n",
    "\n",
    "new_config = {\n",
    "    'path': FINAL_DATASET_DIR,\n",
    "    'train': 'train/images',\n",
    "    'val': 'valid/images',\n",
    "    'names': base_config['names'],\n",
    "    'nc': base_config['nc']\n",
    "}\n",
    "\n",
    "final_yaml_path = f\"{FINAL_DATASET_DIR}/data.yaml\"\n",
    "with open(final_yaml_path, 'w') as f:\n",
    "    yaml.dump(new_config, f)\n",
    "\n",
    "# Update variable global 'dataset' agar kompatibel dengan cell lain\n",
    "class DummyDataset:\n",
    "    location = FINAL_DATASET_DIR\n",
    "dataset = DummyDataset()\n",
    "data_yaml_path = final_yaml_path\n",
    "config = new_config\n",
    "\n",
    "print(f\"\\n✅ DATASET MERGED & READY!\")\n",
    "print(f\"📂 Location: {FINAL_DATASET_DIR}\")\n",
    "print(f\"📄 Config: {final_yaml_path}\")\n",
    "print(f\"🏷️ Classes: {config['names']}\")"
   ]
