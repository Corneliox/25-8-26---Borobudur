    "# --- STEP 3 & 4: TUNING & EVALUATION ---\n",
    "\n",
    "# Daftar model (Gunakan 'n' atau 's' agar GPU Kaggle kuat di imgsz 1280)\n",
    "models_to_compare = ['yolov8n-seg.pt', 'yolo11n-seg.pt', 'yolo26n-seg.pt']\n",
    "summary_results = []\n",
    "\n",
    "for model_name in models_to_compare:\n",
    "    print(f\"\\n{'='*50}\")\n",
    "    print(f\"🔥 STARTING TOURNAMENT: {model_name}\")\n",
    "    print(f\"{'='*50}\")\n",
    "\n",
    "    model = YOLO(model_name)\n",
    "\n",
    "    # Tuning Otomatis\n",
    "    # KUNCI: imgsz=1280 adalah harga mati untuk gambar 4000x6000\n",
    "    model.tune(\n",
    "        data=data_yaml_path,\n",
    "        epochs=30,\n",
    "        iterations=5, # 5 iterasi cukup untuk benchmark awal\n",
    "        optimizer='AdamW',\n",
    "        imgsz=1280, \n",
    "        plots=True,\n",
    "        save=True,\n",
    "        val=True\n",
    "    )\n",
    "\n",
    "    # Ambil metrik validasi terakhir\n",
    "    metrics = model.val(data=data_yaml_path, imgsz=1280)\n",
    "    \n",
    "    summary_results.append({\n",
    "        \"Model\": model_name,\n",
    "        \"mAP50-95(Mask)\": metrics.seg.map,\n",
    "        \"Precision\": metrics.seg.mp,\n",
    "        \"Recall\": metrics.seg.mr,\n",
    "        \"Fitness\": metrics.fitness\n",
    "    })\n",
    "\n",
    "# Tampilkan Tabel Hasil\n",
    "df = pd.DataFrame(summary_results)\n",
    "df_sorted = df.sort_values(by=\"Fitness\", ascending=False)\n",
    "print(\"\\n\\n📊 KESIMPULAN TURNAMEN MODEL:\")\n",
    "print(df_sorted)\n",
    "\n",
    "# Simpan CSV\n",
    "df_sorted.to_csv(\"/kaggle/working/model_comparison_results.csv\", index=False)"
   ]
