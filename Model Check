    "import cv2\n",
    "import numpy as np\n",
    "\n",
    "def apply_clahe_to_image(image):\n",
    "    # Ubah ke Lab color space agar kontras batu lebih tajam tanpa merusak warna\n",
    "    lab = cv2.cvtColor(image, cv2.COLOR_BGR2LAB)\n",
    "    l, a, b = cv2.split(lab)\n",
    "    \n",
    "    # ClipLimit 3.0 untuk penajaman bayangan pahatan yang agresif\n",
    "    clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8,8))\n",
    "    cl = clahe.apply(l)\n",
    "    \n",
    "    limg = cv2.merge((cl, a, b))\n",
    "    enhanced_img = cv2.cvtColor(limg, cv2.COLOR_LAB2BGR)\n",
    "    return enhanced_img\n",
    "\n",
    "print(\"✅ Fungsi CLAHE siap digunakan untuk memper tajam detail relief.\")"
   ]
