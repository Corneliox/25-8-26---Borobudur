    "# --- STEP 3 & 4: MASSIVE TOURNAMENT (OPTIMIZED FOR mAP 20%+) ---\n",
    "\n",
    "# Pastikan menggunakan data yang sudah di-slice\n",
    "data_yaml_path_1 = '/kaggle/working/sliced_data.yaml'\n",
    "models_to_compare = ['yolov8s-seg.pt', 'yolo11s-seg.pt', 'yolo26s-seg.pt']\n",
    "summary_results = []\n",
    "\n",
    "for model_name in models_to_compare:\n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(f\"🔥 TRAINING MASSIVE STRATEGY: {model_name}\")\n",
    "    print(f\"{'='*60}\")\n",
    "\n",
    "    model = YOLO(model_name)\n",
    "\n",
    "    # Menggunakan SGD untuk stabilitas di 500 epochs\n",
    "    model.train(\n",
    "        data=data_yaml_path_1,\n",
    "        imgsz=800,           # Resolusi lebih tinggi untuk detail pori batu\n",
    "        epochs=500,          \n",
    "        batch=16,            # Dioptimalkan untuk Double T4\n",
    "        device=[0, 1],       \n",
    "        optimizer='SGD',     \n",
    "        lr0=0.01,            \n",
    "        momentum=0.937,\n",
    "        # AUGMENTASI KHUSUS ARKEOLOGI DIGITAL\n",
    "        mosaic=1.0,\n",
    "        mixup=0.3,           # Membantu memisahkan anatomi yang berhimpitan\n",
    "        copy_paste=0.3,      # Menambah variasi objek pada background batu kosong\n",
    "        perspective=0.001,   # Menangani distorsi sudut kamera\n",
    "        degrees=15,          \n",
    "        scale=0.5,           \n",
    "        close_mosaic=50,     # Fokus pada bentuk asli di akhir training\n",
    "        box=15.0,            # Sensitivitas tinggi terhadap batas anatomi\n",
    "        cls=3.0,             # Penajaman klasifikasi kelas\n",
    "        patience=100,        \n",
    "        save=True,\n",
    "        project=\"/kaggle/working/final_push\",\n",
    "        name=f\"ultra_{model_name.split('.')[0]}\"\n",
    "    )\n",
    "\n",
    "    # Validasi Akhir\n",
    "    print(f\"🧐 Validating {model_name}...\")\n",
    "    metrics = model.val(imgsz=800) \n",
    "    \n",
    "    summary_results.append({\n",
    "        \"Model\": model_name,\n",
    "        \"mAP50-95(Mask)\": metrics.seg.map,\n",
    "        \"Precision\": metrics.seg.mp,\n",
    "        \"Recall\": metrics.seg.mr,\n",
    "        \"Fitness\": metrics.fitness\n",
    "    })\n",
    "\n",
    "# --- HASIL AKHIR ---\n",
    "df = pd.DataFrame(summary_results)\n",
    "df_sorted = df.sort_values(by=\"Fitness\", ascending=False)\n",
    "print(\"\\n📊 HASIL TURNAMEN ULTRA (Target 20%+):\")\n",
    "print(df_sorted.to_string(index=False))\n",
    "df_sorted.to_csv(\"/kaggle/working/ultra_results.csv\", index=False)"
