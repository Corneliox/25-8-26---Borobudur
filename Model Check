    "import os\n",
    "import torch\n",
    "import gc\n",
    "from ultralytics import YOLO\n",
    "import pandas as pd\n",
    "\n",
    "# --- KONFIGURASI MEMORY-SAFE ---\n",
    "# 1. Gunakan settingan internal PyTorch untuk cegah fragmentasi memori\n",
    "os.environ[\"PYTORCH_CUDA_ALLOC_CONF\"] = \"expandable_segments:True\"\n",
    "\n",
    "data_yaml_path_1 = '/kaggle/working/sliced_data.yaml'\n",
    "models_to_compare = ['yolov8m-seg.pt', 'yolo11m-seg.pt', 'yolo26m-seg.pt'] # Fokus ke 11 & 26 (terkuat)\n",
    "summary_results = []\n",
    "\n",
    "for model_name in models_to_compare:\n",
    "    # 2. Bersihkan sampah memori dari run sebelumnya\n",
    "    torch.cuda.empty_cache()\n",
    "    gc.collect()\n",
    "    \n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(f\"🔥 TRAINING MASSIVE STRATEGY (VRAM SAFE): {model_name}\")\n",
    "    print(f\"{'='*60}\")\n",
    "\n",
    "    model = YOLO(model_name)\n",
    "\n",
    "    model.train(\n",
    "        data=data_yaml_path_1,\n",
    "        imgsz=800,           # TURUNKAN KE 640 (Wajib untuk model Medium di T4)\n",
    "        epochs=1000,          # 500 sudah cukup untuk konvergensi awal\n",
    "        batch=8,             # Tetap 8 (terbagi 4 per GPU)\n",
    "        device=[0, 1],       \n",
    "        optimizer='AdamW',     \n",
    "        lr0=0.001,  \n",
    "        lrf=0.01,\n",
    "        # AUGMENTASI TETAP AGRESIF\n",
    "        mosaic=1.0,\n",
    "        mixup=0.2,           \n",
    "        copy_paste=0.3,      \n",
    "        perspective=0.0005,  \n",
    "        degrees=10,          \n",
    "        close_mosaic=30,     \n",
    "        box=10.0,            # Normalisasi agar gradien tidak meledak\n",
    "        cls=2.0,             \n",
    "        patience=50,         \n",
    "        amp=True,            # Mixed Precision sangat penting untuk hemat VRAM\n",
    "        cache=False,         # Matikan cache gambar agar RAM GPU lega\n",
    "        project=\"/kaggle/working/final_push\",\n",
    "        name=f\"ultra_{model_name.split('.')[0]}\",\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "    # Validasi\n",
    "    print(f\"🧐 Validating {model_name}...\")\n",
    "    metrics = model.val(imgsz=640) \n",
    "    \n",
    "    summary_results.append({\n",
    "        \"Model\": model_name,\n",
    "        \"mAP50-95(Mask)\": metrics.seg.map,\n",
    "        \"Precision\": metrics.seg.mp,\n",
    "        \"Recall\": metrics.seg.mr,\n",
    "        \"Fitness\": metrics.fitness\n",
    "    })\n",
    "\n",
    "# --- DISPLAY RESULTS ---\n",
    "df = pd.DataFrame(summary_results)\n",
    "if not df.empty:\n",
    "    df_sorted = df.sort_values(by=\"Fitness\", ascending=False)\n",
    "    print(\"\\n📊 HASIL TURNAMEN MASSIVE:\")\n",
    "    print(df_sorted.to_string(index=False))\n",
    "    df_sorted.to_csv(\"/kaggle/working/ultra_results.csv\", index=False)"
   ]
