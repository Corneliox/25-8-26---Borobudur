    "import os\n",
    "import torch\n",
    "import gc\n",
    "import pandas as pd\n",
    "from ultralytics import YOLO\n",
    "from codecarbon import EmissionsTracker\n",
    "\n",
    "os.environ[\"PYTORCH_CUDA_ALLOC_CONF\"] = \"expandable_segments:True\"\n",
    "\n",
    "# --- GREEN AI CALLBACK SETUP ---\n",
    "tracker = None\n",
    "current_model_name = \"unknown\"\n",
    "\n",
    "def on_train_epoch_start(trainer):\n",
    "    global tracker\n",
    "    project_name = f\"{current_model_name}_Epoch_{trainer.epoch + 1}\"\n",
    "    tracker = EmissionsTracker(project_name=project_name, output_file=\"/kaggle/working/green_ai_emissions.csv\", log_level=\"error\")\n",
    "    tracker.start()\n",
    "\n",
    "def on_train_epoch_end(trainer):\n",
    "    global tracker\n",
    "    if tracker: tracker.stop()\n",
    "\n",
    "# --- SETUP TURNAMEN ---\n",
    "data_yaml_path_1 = '/kaggle/working/cropped_data_v3.yaml'\n",
    "models_to_compare = ['yolov8n-seg.pt', 'yolo11n-seg.pt', 'yolo26n-seg.pt'] \n",
    "summary_results = []\n",
    "\n",
    "for model_name in models_to_compare:\n",
    "    torch.cuda.empty_cache()\n",
    "    gc.collect()\n",
    "    \n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(f\"🌱 GREEN AI TOURNAMENT: {model_name}\")\n",
    "    print(f\"{'='*60}\")\n",
    "\n",
    "    model = YOLO(model_name)\n",
    "    \n",
    "    # Injeksi Green AI Sensor\n",
    "    global current_model_name\n",
    "    current_model_name = model_name.split('.')[0]\n",
    "    \n",
    "    # model.clear_callbacks()\n",
    "    model.add_callback(\"on_train_epoch_start\", on_train_epoch_start)\n",
    "    model.add_callback(\"on_train_epoch_end\", on_train_epoch_end)\n",
    "\n",
    "    # Memulai Training\n",
    "    model.train(\n",
    "        data=data_yaml_path_1,\n",
    "        imgsz=640,          \n",
    "        epochs=50,          # Gunakan 50 dulu untuk test run Turnamen\n",
    "        batch=24,            \n",
    "        device=[0, 1],      # Kaggle T4x2       \n",
    "        optimizer='SGD',      \n",
    "        project=\"/kaggle/working/green_ai_tournament\",\n",
    "        name=current_model_name,\n",
    "        exist_ok=True,\n",
    "        plots=True\n",
    "    )\n",
    "\n",
    "    # 2. Panggil Validasi Secara Eksplisit (Ini menjamin kita dapat angkanya!)\n",
    "    print(f\"\\n🧐 Menarik rapor validasi untuk {current_model_name}...\")\n",
    "    metrics = model.val(data=data_yaml_path_1, split='val')\n",
    "    \n",
    "    # 3. Simpan Hasilnya dengan pengecekan aman\n",
    "    try:\n",
    "        map_score = metrics.seg.map  # Ambil metrik mask/segmentasi\n",
    "    except AttributeError:\n",
    "        # Jika sewaktu-waktu model berubah ke object detection biasa\n",
    "        map_score = metrics.box.map\n",
    "    \n",
    "    summary_results.append({\n",
    "        \"Model\": current_model_name,\n",
    "        \"mAP50-95(Mask)\": metrics.seg.map,\n",
    "        \"Fitness\": metrics.fitness\n",
    "    })\n",
    "\n",
    "# --- HASIL TURNAMEN ---\n",
    "df = pd.DataFrame(summary_results)\n",
    "if not df.empty:\n",
    "    df_sorted = df.sort_values(by=\"Fitness\", ascending=False)\n",
    "    print(\"\\n📊 HASIL FINAL TURNAMEN:\")\n",
    "    print(df_sorted.to_string(index=False))\n",
    "else:\n",
    "    print(\"\\n⚠️ Tidak ada hasil yang bisa ditampilkan. Pastikan training berjalan dengan benar.\")"
   ]
