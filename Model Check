    "# --- STEP 3 & 4: MASSIVE TOURNAMENT (OPTIMIZED FOR mAP 20%+) ---\n",
    "\n",
    "# Pastikan menggunakan data yang sudah di-slice\n",
    "data_yaml_path_1 = '/kaggle/working/sliced_data.yaml'\n",
    "models_to_compare = ['yolov8n-seg.pt', 'yolo11n-seg.pt', 'yolo26n-seg.pt']\n",
    "summary_results = []\n",
    "\n",
    "for model_name in models_to_compare:\n",
    "    print(f\"\\n{'='*50}\")\n",
    "    print(f\"🔥 TRAINING MASSIVE STRATEGY: {model_name}\")\n",
    "    print(f\"{'='*50}\")\n",
    "\n",
    "    model = YOLO(model_name)\n",
    "\n",
    "    # Menggunakan .train() dengan parameter hasil 'best practice' untuk relief\n",
    "    # Agar target mAP 20% tercapai dengan 10 gambar (setelah di-slice)\n",
    "    model.train(\n",
    "        data=data_yaml_path_1,\n",
    "        imgsz=640,           # Tetap 640 karena input sudah berupa tiles\n",
    "        epochs=500,          # Memberi waktu AI belajar tekstur batu\n",
    "        batch=32,            # Diperbesar karena pakai 2 GPU (16 per GPU)\n",
    "        device=[0, 1],       # MENGAKTIFKAN DOUBLE T4 GPU\n",
    "        optimizer='AdamW',\n",
    "        lr0=0.001,           # Learning rate awal\n",
    "        lrf=0.01,            # Learning rate akhir (cosine)\n",
    "        mosaic=1.0,          # Augmentasi Mosaic penuh\n",
    "        mixup=0.2,           # Membantu AI membedakan objek tumpang tindih\n",
    "        close_mosaic=20,     # Sangat krusial: stabilisasi di akhir training\n",
    "        box=10.0,            # Sensitivitas tinggi terhadap deteksi kotak\n",
    "        cls=2.0,             # Fokus tinggi pada klasifikasi anatomi\n",
    "        patience=100,        # Jangan menyerah jika mAP sempat flat\n",
    "        overlap_mask=True,   # Cocok untuk anatomi relief yang bertumpuk\n",
    "        save=True,\n",
    "        plots=True,\n",
    "        project=\"/kaggle/working/massive_run\",\n",
    "        name=f\"run_{model_name.split('.')[0]}\"\n",
    "    )\n",
    "\n",
    "    # Validasi Akhir menggunakan model terbaik hasil training tadi\n",
    "    print(f\"🧐 Validating {model_name}...\")\n",
    "    metrics = model.val(imgsz=640) \n",
    "    \n",
    "    summary_results.append({\n",
    "        \"Model\": model_name,\n",
    "        \"mAP50-95(Mask)\": metrics.seg.map,\n",
    "        \"Precision\": metrics.seg.mp,\n",
    "        \"Recall\": metrics.seg.mr,\n",
    "        \"Fitness\": metrics.fitness\n",
    "    })\n",
    "\n",
    "# --- DISPLAY & SAVE RESULTS ---\n",
    "df = pd.DataFrame(summary_results)\n",
    "df_sorted = df.sort_values(by=\"Fitness\", ascending=False)\n",
    "\n",
    "print(\"\\n\\n📊 KESIMPULAN TURNAMEN MODEL (FINAL):\")\n",
    "print(df_sorted.to_string(index=False))\n",
    "\n",
    "# Simpan CSV hasil akhir\n",
    "df_sorted.to_csv(\"/kaggle/working/massive_tournament_results.csv\", index=False)"
   ]
