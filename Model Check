    "import os\n",
    "import glob\n",
    "from tqdm.notebook import tqdm\n",
    "\n",
    "def clean_empty_labels(dataset_dir):\n",
    "    print(f\"🧹 Membersihkan Dataset di: {dataset_dir}\")\n",
    "    \n",
    "    total_deleted = 0\n",
    "    splits = ['train', 'valid']\n",
    "    \n",
    "    for split in splits:\n",
    "        img_dir = os.path.join(dataset_dir, split, 'images')\n",
    "        lbl_dir = os.path.join(dataset_dir, split, 'labels')\n",
    "        \n",
    "        # Ambil semua gambar\n",
    "        images = glob.glob(os.path.join(img_dir, \"*.jpg\"))\n",
    "        \n",
    "        print(f\"   📂 Memeriksa {split}: {len(images)} gambar...\")\n",
    "        \n",
    "        for img_path in tqdm(images):\n",
    "            # Cari label pasangannya\n",
    "            basename = os.path.basename(img_path)\n",
    "            txt_name = basename.replace('.jpg', '.txt')\n",
    "            txt_path = os.path.join(lbl_dir, txt_name)\n",
    "            \n",
    "            # Cek kondisi\n",
    "            should_delete = False\n",
    "            \n",
    "            # 1. Jika file txt tidak ada\n",
    "            if not os.path.exists(txt_path):\n",
    "                should_delete = True\n",
    "            \n",
    "            # 2. Jika file txt ada tapi KOSONG (0 bytes atau isinya kosong)\n",
    "            else:\n",
    "                with open(txt_path, 'r') as f:\n",
    "                    content = f.read().strip()\n",
    "                    if not content:\n",
    "                        should_delete = True\n",
    "            \n",
    "            # Hapus jika memenuhi kriteria\n",
    "            if should_delete:\n",
    "                os.remove(img_path) # Hapus Gambar\n",
    "                if os.path.exists(txt_path):\n",
    "                    os.remove(txt_path) # Hapus Label kosong (jika ada)\n",
    "                total_deleted += 1\n",
    "\n",
    "    print(f\"\\n✅ Selesai! Total gambar 'sampah' (kosong) dihapus: {total_deleted}\")\n",
    "    print(\"Dataset sekarang jauh lebih padat dan fokus.\")\n",
    "\n",
    "# Eksekusi Pembersihan\n",
    "clean_empty_labels('/kaggle/working/sliced_dataset_v2')"
   ]
