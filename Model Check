    "# --- STEP 1: INSTALL & SETUP ---\n",
    "import os\n",
    "import yaml\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import cv2\n",
    "from ultralytics import YOLO\n",
    "from roboflow import Roboflow\n",
    "\n",
    "# Mengambil API Key secara aman dari Kaggle Secrets\n",
    "from kaggle_secrets import UserSecretsClient\n",
    "user_secrets = UserSecretsClient()\n",
    "my_api = user_secrets.get_secret(\"roboflow borobudur api\")\n",
    "\n",
    "# --- STEP 2: DOWNLOAD DATASET ---\n",
    "rf = Roboflow(api_key=my_api)\n",
    "project = rf.workspace(\"cornelio\").project(\"borobudur-kelompok-1\")\n",
    "version = project.version(3)\n",
    "dataset = version.download(\"yolov8\")\n",
    "\n",
    "# Jalur YAML di Kaggle biasanya di /kaggle/working/\n",
    "data_yaml_path = os.path.join(dataset.location, \"data.yaml\")\n",
    "\n",
    "# Perbaikan Path di YAML agar Kaggle bisa membaca folder dataset dengan benar\n",
    "with open(data_yaml_path, 'r') as f:\n",
    "    config = yaml.safe_load(f)\n",
    "\n",
    "config['train'] = os.path.join(dataset.location, \"train/images\")\n",
    "config['val'] = os.path.join(dataset.location, \"valid/images\")\n",
    "if 'test' in config:\n",
    "    config['test'] = os.path.join(dataset.location, \"test/images\")\n",
    "\n",
    "with open(data_yaml_path, 'w') as f:\n",
    "    yaml.dump(config, f)\n",
    "\n",
    "print(f\"✅ Dataset ready and YAML paths updated at: {data_yaml_path}\")"
   ]
