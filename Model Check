    "import os\n",
    "import torch\n",
    "import gc\n",
    "from ultralytics import YOLO\n",
    "import pandas as pd\n",
    "\n",
    "# --- KONFIGURASI MEMORY-SAFE ---\n",
    "os.environ[\"PYTORCH_CUDA_ALLOC_CONF\"] = \"expandable_segments:True\"\n",
    "\n",
    "data_yaml_path_1 = '/kaggle/working/sliced_data_v2.yaml'\n",
    "# Pastikan ini menunjuk ke model pretrained/custom yang benar\n",
    "models_to_compare = ['yolo26m-seg.pt'] \n",
    "summary_results = []\n",
    "\n",
    "for model_name in models_to_compare:\n",
    "    # 1. Bersihkan sampah memori\n",
    "    torch.cuda.empty_cache()\n",
    "    gc.collect()\n",
    "    \n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(f\"🔥 TRAINING MAX POWER (TARGET: 10-12GB VRAM): {model_name}\")\n",
    "    print(f\"{'='*60}\")\n",
    "\n",
    "    # Load Model (Bisa dari checkpoint sebelumnya atau pretrained)\n",
    "    # Jika yolo26m-seg.pt tidak ada di folder, pastikan path-nya benar\n",
    "    try:\n",
    "        model = YOLO(model_name)\n",
    "    except:\n",
    "        print(f\"⚠️ {model_name} tidak ditemukan, menggunakan yolov8m-seg.pt sebagai base...\")\n",
    "        model = YOLO('yolov8m-seg.pt')\n",
    "\n",
    "    model.train(\n",
    "        data=data_yaml_path_1,\n",
    "        imgsz=640,           # Tetap 640 (karena data sudah di-slice 640, diperbesar pun percuma)\n",
    "        epochs=100,          \n",
    "        \n",
    "        # --- PERUBAHAN UTAMA DI SINI ---\n",
    "        batch=24,            # Lonjakan Besar! (8 -> 48). Ini akan memakan VRAM ~10-12GB\n",
    "        # workers=8,           # Pakai semua core CPU Kaggle untuk loading data\n",
    "        cache=True,          # Simpan data di RAM System (bukan VRAM) agar ngebut\n",
    "        \n",
    "        device=[0, 1],       # Dual GPU aktif\n",
    "        optimizer='SGD',      \n",
    "        lr0=0.01,  \n",
    "        # lrf=0.01,\n",
    "        \n",
    "        # AUGMENTASI (Tetap Agresif)\n",
    "        mosaic=0.5,\n",
    "        mixup=0.0,            \n",
    "        copy_paste=0.0,      \n",
    "        # perspective=0.0005,  \n",
    "        # degrees=10,          \n",
    "        # close_mosaic=30,     \n",
    "        \n",
    "        # Loss Gains\n",
    "        box=7.5,            \n",
    "        cls=0.5,             \n",
    "        dfl=1.5,\n",
    "        \n",
    "        # patience=50,         \n",
    "        # amp=True,            # Tetap True agar VRAM muat Batch 48\n",
    "        \n",
    "        project=\"/kaggle/working/remedial_run\",\n",
    "        name=f\"ultra_max_{model_name.split('.')[0]}\",\n",
    "        exist_ok=True,\n",
    "        plots=True\n",
    "    )\n",
    "\n",
    "    # Validasi\n",
    "    print(f\"🧐 Validating {model_name}...\")\n",
    "    metrics = model.val(imgsz=640) \n",
    "    \n",
    "    summary_results.append({\n",
    "        \"Model\": model_name,\n",
    "        \"mAP50-95(Mask)\": metrics.seg.map,\n",
    "        \"Precision\": metrics.seg.mp,\n",
    "        \"Recall\": metrics.seg.mr,\n",
    "        \"Fitness\": metrics.fitness\n",
    "    })\n",
    "\n",
    "# --- DISPLAY RESULTS ---\n",
    "df = pd.DataFrame(summary_results)\n",
    "if not df.empty:\n",
    "    df_sorted = df.sort_values(by=\"Fitness\", ascending=False)\n",
    "    print(\"\\n📊 HASIL FINAL MAX POWER:\")\n",
    "    print(df_sorted.to_string(index=False))\n",
    "    df_sorted.to_csv(\"/kaggle/working/ultra_results_max.csv\", index=False)"
   ]
