    "import os\n",
    "import cv2\n",
    "import yaml\n",
    "import shutil\n",
    "import numpy as np\n",
    "from tqdm.notebook import tqdm\n",
    "from shapely.geometry import Polygon\n",
    "from shapely.ops import unary_union\n",
    "\n",
    "# --- KONFIGURASI ISOLASI OBJEK ---\n",
    "INPUT_DIR = \"/kaggle/working/final_dataset\"  # Dataset utuh hasil merge\n",
    "OUTPUT_DIR = \"/kaggle/working/cropped_dataset_v4\" # Dataset potongan\n",
    "PADDING = 30 # Lebihkan 30 pixel agar tidak mepet\n",
    "CONNECT_BUFFER = 25 # Toleransi jarak (pixel) untuk menggabungkan bagian tubuh yang terputus sedikit\n",
    "\n",
    "if os.path.exists(OUTPUT_DIR): shutil.rmtree(OUTPUT_DIR)\n",
    "\n",
    "def process_contextual_crop(split_name):\n",
    "    image_dir = f\"{INPUT_DIR}/{split_name}/images\"\n",
    "    label_dir = f\"{INPUT_DIR}/{split_name}/labels\"\n",
    "    \n",
    "    out_img_dir = f\"{OUTPUT_DIR}/{split_name}/images\"\n",
    "    out_lbl_dir = f\"{OUTPUT_DIR}/{split_name}/labels\"\n",
    "    os.makedirs(out_img_dir, exist_ok=True)\n",
    "    os.makedirs(out_lbl_dir, exist_ok=True)\n",
    "\n",
    "    if not os.path.exists(image_dir): return\n",
    "    image_files = [f for f in os.listdir(image_dir) if f.endswith(('.jpg', '.jpeg', '.png'))]\n",
    "    print(f\"✂️ Membuat Contextual Crops [{split_name}] - {len(image_files)} gambar...\")\n",
    "    \n",
    "    for img_file in tqdm(image_files):\n",
    "        img_path = os.path.join(image_dir, img_file)\n",
    "        txt_path = os.path.join(label_dir, img_file.rsplit('.', 1)[0] + '.txt')\n",
    "        if not os.path.exists(txt_path): continue\n",
    "            \n",
    "        img = cv2.imread(img_path)\n",
    "        h_orig, w_orig = img.shape[:2]\n",
    "        \n",
    "        with open(txt_path, 'r') as f:\n",
    "            lines = f.readlines()\n",
    "            \n",
    "        # 1. PARSING SEMUA POLIGON DI GAMBAR\n",
    "        polys_info = []\n",
    "        for line in lines:\n",
    "            parts = line.strip().split()\n",
    "            if len(parts) < 7: continue \n",
    "            \n",
    "            cls_id = int(parts[0])\n",
    "            coords = np.array([float(x) for x in parts[1:]]).reshape(-1, 2)\n",
    "            abs_coords = coords * [w_orig, h_orig]\n",
    "            \n",
    "            poly = Polygon(abs_coords)\n",
    "            if poly.is_valid:\n",
    "                polys_info.append((cls_id, poly, abs_coords))\n",
    "                \n",
    "        if not polys_info: continue\n",
    "\n",
    "        # 2. LOGIKA PENGELOMPOKAN (Saling Menyentuh / Berseberangan)\n",
    "        # Kita perbesar sedikit poligonnya (buffer) lalu kita lebur (union)\n",
    "        # Jika tangan dan torso berdekatan, mereka akan melebur jadi 1 \"Cluster / Orang\"\n",
    "        buffered_polys = [p[1].buffer(CONNECT_BUFFER) for p in polys_info]\n",
    "        merged_clusters = unary_union(buffered_polys)\n",
    "        \n",
    "        # Pisahkan kembali hasil leburan menjadi list cluster (tiap cluster = 1 orang)\n",
    "        clusters = [merged_clusters] if merged_clusters.geom_type == 'Polygon' else list(merged_clusters.geoms)\n",
    "\n",
    "        # 3. PROSES PEMOTONGAN BERDASARKAN CLUSTER (ORANG UTUH)\n",
    "        for idx, cluster in enumerate(clusters):\n",
    "            # Ambil titik paling ekstrim (Kiri, Bawah, Kanan, Atas) dari orang tersebut\n",
    "            minx, miny, maxx, maxy = cluster.bounds\n",
    "            \n",
    "            # Tambahkan Padding agar tidak mepet\n",
    "            x_min = max(0, int(minx - PADDING))\n",
    "            y_min = max(0, int(miny - PADDING))\n",
    "            x_max = min(w_orig, int(maxx + PADDING))\n",
    "            y_max = min(h_orig, int(maxy + PADDING))\n",
    "            \n",
    "            crop_img = img[y_min:y_max, x_min:x_max]\n",
    "            h_crop, w_crop = crop_img.shape[:2]\n",
    "            if w_crop <= 30 or h_crop <= 30: continue \n",
    "            \n",
    "            new_annotations = []\n",
    "            \n",
    "            # 4. CARI LABEL MANA SAJA YANG MASUK KE DALAM ORANG INI\n",
    "            for cls_id, poly, abs_coords in polys_info:\n",
    "                # Jika bagian tubuh ini bersentuhan dengan cluster ini\n",
    "                if cluster.intersects(poly):\n",
    "                    # Hitung ulang koordinatnya agar pas di gambar potongan\n",
    "                    new_coords = []\n",
    "                    for pt in abs_coords:\n",
    "                        nx = max(0.0, min(1.0, (pt[0] - x_min) / w_crop))\n",
    "                        ny = max(0.0, min(1.0, (pt[1] - y_min) / h_crop))\n",
    "                        new_coords.append(f\"{nx:.6f} {ny:.6f}\")\n",
    "                    \n",
    "                    new_annotations.append(f\"{cls_id} {' '.join(new_coords)}\")\n",
    "            \n",
    "            # 5. SIMPAN HASIL\n",
    "            if new_annotations:\n",
    "                crop_name = f\"{img_file.rsplit('.', 1)[0]}_person{idx}\"\n",
    "                cv2.imwrite(f\"{out_img_dir}/{crop_name}.jpg\", crop_img)\n",
    "                with open(f\"{out_lbl_dir}/{crop_name}.txt\", 'w') as f_out:\n",
    "                    f_out.write(\"\\n\".join(new_annotations))\n",
    "\n",
    "# Eksekusi\n",
    "process_contextual_crop('train')\n",
    "process_contextual_crop('valid')\n",
    "\n",
    "# --- SETUP YAML BARU ---\n",
    "with open(f\"{INPUT_DIR}/data.yaml\", 'r') as f:\n",
    "    base_config = yaml.safe_load(f)\n",
    "\n",
    "new_yaml = {\n",
    "    'path': OUTPUT_DIR,\n",
    "    'train': 'train/images',\n",
    "    'val': 'valid/images',\n",
    "    'names': base_config['names'], \n",
    "    'nc': base_config['nc']        \n",
    "}\n",
    "yaml_path = \"/kaggle/working/contextual_crops_v4.yaml\"\n",
    "with open(yaml_path, 'w') as f: yaml.dump(new_yaml, f)\n",
    "\n",
    "print(f\"✅ CONTEXTUAL CROP SELESAI! Yaml baru: {yaml_path}\")"
   ]
  },
